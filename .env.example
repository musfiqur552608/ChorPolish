# Supabase project settings → API
# Only public values belong in a Vite client. NEVER add a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Set to "true" to show the offline, bot-powered demo on the landing
# page even when Supabase is configured. The demo never writes to Supabase.
VITE_ENABLE_DEMO=true
